{
  "manifest_version": 3,
  "name": "Script → Footage Studio",
  "version": "1.1.0",
  "version_name": "1.1.0 - logo fly-in matched to reference",
  "description": "Pair numbered script lines with stock footage while you browse, then open the built-in editor to auto-sync a Spanish voiceover and export 1080p.",
  "permissions": ["storage","scripting", "unlimitedStorage", "downloads", "tabs", "contextMenus", "declarativeNetRequest", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Script → Footage workspace" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [{
    "matches": [
      "*://*.pexels.com/*", "*://*.pixabay.com/*", "*://*.mixkit.co/*", "*://*.coverr.co/*",
      "*://*.videvo.net/*", "*://*.videezy.com/*", "*://*.vecteezy.com/*", "*://*.pond5.com/*",
      "*://*.shutterstock.com/*", "*://*.storyblocks.com/*", "*://*.elements.envato.com/*",
      "*://*.istockphoto.com/*", "*://stock.adobe.com/*", "*://*.freepik.com/*",
      "*://*.dreamstime.com/*", "*://*.depositphotos.com/*", "*://*.motionelements.com/*",
      "*://*.artgrid.io/*", "*://*.motionarray.com/*", "*://*.dissolve.com/*", "*://*.videoblocks.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "sandbox": { "pages": ["editor.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads; script-src 'self' 'unsafe-inline' 'unsafe-eval'; object-src 'self'"
  }
}
